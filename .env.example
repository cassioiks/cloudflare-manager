# Copy this file to .env and fill in CF_API_TOKEN. Never commit .env.

# Required. Cloudflare API token with "Zone · DNS · Edit" and "Zone · Zone · Read".
# Create one at https://dash.cloudflare.com/profile/api-tokens (see README).
CF_API_TOKEN=

# ---- Optional (defaults shown) ----

# Port for the web UI.
# PORT=5480

# Address to listen on. 127.0.0.1 = this machine only.
# Use 0.0.0.0 to reach it from other devices on your network (then set BASIC_AUTH).
# HOST=127.0.0.1

# Password-protect the UI and API, as user:password.
# BASIC_AUTH=admin:change-me

# Without BASIC_AUTH, only requests to localhost or an IP address are accepted.
# List extra hostnames here (comma-separated) to allow them, e.g. homeserver.local
# ALLOWED_HOSTS=

# Where state (managed records, schedule, update log) is stored.
# DATA_DIR=./data
